# Build outputs (generated by tools/build_package.py / Rime deployment)
dist/
build/
*.zip

# Test output
tests/cases/*.log

# Node dependencies (wasmoon Lua sandbox)
node_modules/

# Python caches and virtualenvs
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Editor / OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local scratch files
*.tmp
*.swp

# Intentionally tracked generated data (consumed directly by the runtime/tests):
#   src/lua/mgjy_data.lua
#   data/phrases.json
#   tests/lua/full_data.json, tests/lua/full_data.lua
#   tests/cases/eval_cases.json
# These are regenerable, but keeping them makes the schema installable and the
# regression suite runnable without a Python toolchain.
